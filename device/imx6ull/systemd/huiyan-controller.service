[Unit]
Description=Huiyan i.MX6ULL controller
After=network-online.target huiyan-led-helper.service
Wants=network-online.target huiyan-led-helper.service

[Service]
Type=simple
User=debian
Group=debian
SupplementaryGroups=input huiyan-led
WorkingDirectory=/home/debian/huiyan-shizhu
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m device.imx6ull.controller_main --mode imx6ull --config /home/debian/huiyan-shizhu/device/imx6ull/config/controller.json --host 0.0.0.0
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
